{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated student profile aligned to Class 6-12 Indian educational boards.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "emailVerified": { "type": "boolean" },
        "authProvider": { "type": "string", "enum": ["google", "password"] },
        "username": { "type": "string", "maxLength": 24 },
        "displayName": { "type": "string", "maxLength": 100 },
        "avatarId": { "type": "string", "maxLength": 48 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "board": {
          "type": "string",
          "enum": ["CBSE", "CISCE", "ICSE", "ISC", "StateBoard", "Other"]
        },
        "classGrade": {
          "type": "string",
          "enum": [
            "Class 6",
            "Class 7",
            "Class 8",
            "Class 9",
            "Class 10",
            "Class 11",
            "Class 12"
          ]
        },
        "state": { "type": "string", "maxLength": 80 },
        "language": {
          "type": "string",
          "enum": ["English", "Hindi", "Hinglish", "Bilingual"]
        },
        "subjects": { "type": "array" },
        "learningGoals": { "type": "array" },
        "onboardingCompleted": { "type": "boolean" },
        "streakDays": { "type": "integer" },
        "xpPoints": { "type": "integer" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "displayName", "role", "board", "classGrade", "language"]
    },
    "UsernameClaim": {
      "title": "UsernameClaim",
      "description": "Atomic unique username registry mapping normalized lowercase handle to owning user UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 24 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "username", "createdAt"]
    },
    "ExamDatesheet": {
      "title": "ExamDatesheet",
      "description": "Structured, student-verified exam datesheet schedule bound to the owning student UID (excludes raw binary uploads).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 160 },
        "status": { "type": "string", "enum": ["draft", "confirmed"] },
        "metadata": {
          "type": "object",
          "properties": {
            "examName": { "type": "string", "maxLength": 160 },
            "board": { "type": "string", "maxLength": 80 },
            "classGrade": { "type": "string", "maxLength": 40 },
            "academicSession": { "type": "string", "maxLength": 40 },
            "importantInstructions": { "type": "array" },
            "isUncertain": { "type": "boolean" },
            "uncertaintyReasons": { "type": "array" }
          },
          "required": [
            "examName",
            "board",
            "classGrade",
            "academicSession",
            "importantInstructions",
            "isUncertain",
            "uncertaintyReasons"
          ]
        },
        "entries": { "type": "array" },
        "sourceFiles": { "type": "array" },
        "confirmedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": [
        "id",
        "userId",
        "title",
        "status",
        "metadata",
        "entries",
        "sourceFiles",
        "createdAt",
        "updatedAt"
      ]
    },
    "ExamActivity": {
      "title": "ExamActivity",
      "description": "UID-scoped recent activity entry recording real exam datesheet actions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "datesheetId": { "type": "string", "maxLength": 128 },
        "action": {
          "type": "string",
          "enum": ["analyzed", "saved_draft", "confirmed", "updated", "deleted"]
        },
        "title": { "type": "string", "maxLength": 160 },
        "detail": { "type": "string", "maxLength": 320 },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "datesheetId", "action", "title", "detail", "timestamp"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Read-only platform administrator authorization marker.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "role": { "type": "string", "enum": ["admin"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Student profile documents strictly isolated per UID."
    },
    "/usernames/{username}": {
      "schema": { "$ref": "#/entities/UsernameClaim" },
      "description": "Unique lowercase handle registry ensuring atomic username reservations."
    },
    "/exam_datesheets/{datesheetId}": {
      "schema": { "$ref": "#/entities/ExamDatesheet" },
      "description": "Student exam datesheet drafts and confirmed schedules for Module 1."
    },
    "/exam_activities/{activityId}": {
      "schema": { "$ref": "#/entities/ExamActivity" },
      "description": "Truthful chronological activity feed for datesheet analysis and confirmation events."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Platform admin markers managed via backend/Console only."
    }
  }
}
