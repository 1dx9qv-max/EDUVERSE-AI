rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'a40332177@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isVerifiedGuardianWithPermission(studentUid, permKey) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/guardians/$(request.auth.uid + '_' + studentUid)) &&
        get(/databases/$(database)/documents/guardians/$(request.auth.uid + '_' + studentUid)).data.status == 'verified' &&
        get(/databases/$(database)/documents/guardians/$(request.auth.uid + '_' + studentUid)).data.permissions[permKey] == true
      );
    }

    function isVerifiedGuardianOf(studentUid) {
      return isVerifiedGuardianWithPermission(studentUid, 'canViewProgress');
    }

    function isValidUsernameId(u) {
      return u is string && u.size() >= 3 && u.size() <= 24 && u.matches('^[a-z][a-z0-9_]{2,23}$');
    }

    function isValidUsernameClaim(data) {
      return data.keys().hasAll(['uid', 'username', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'username', 'createdAt']) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        isValidUsernameId(data.username) &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Entity validation functions
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'board', 'classGrade', 'language']) &&
        data.keys().hasOnly(['uid', 'email', 'emailVerified', 'authProvider', 'username', 'displayName', 'avatarId', 'role', 'status', 'board', 'classGrade', 'state', 'language', 'subjects', 'learningGoals', 'onboardingCompleted', 'streakDays', 'xpPoints', 'createdAt', 'updatedAt', 'photoURL']) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        (!('username' in data) || isValidUsernameId(data.username)) &&
        (!('avatarId' in data) || (data.avatarId is string && data.avatarId.size() <= 48)) &&
        (!('emailVerified' in data) || data.emailVerified is bool) &&
        (!('authProvider' in data) || data.authProvider in ['google', 'password']) &&
        data.role in ['student', 'guardian', 'teacher', 'admin'] &&
        (!('status' in data) || data.status in ['active', 'suspended']) &&
        data.board in ['CBSE', 'CISCE', 'ICSE', 'ISC', 'StateBoard', 'Other'] &&
        data.classGrade in ['Class 6', 'Class 7', 'Class 8', 'Class 9', 'Class 10', 'Class 11', 'Class 12'] &&
        data.language in ['English', 'Hindi', 'Bilingual', 'Hinglish'];
    }

    function isValidGuardianLink(data) {
      return data.keys().hasAll(['id', 'guardianUid', 'studentUid', 'relationship', 'status', 'permissions']) &&
        data.keys().hasOnly(['id', 'guardianUid', 'guardianName', 'studentUid', 'studentDisplayName', 'relationship', 'status', 'permissions', 'verifiedAt', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.guardianUid is string && data.guardianUid.size() > 0 && data.guardianUid.size() <= 128 &&
        data.studentUid is string && data.studentUid.size() > 0 && data.studentUid.size() <= 128 &&
        data.guardianUid != data.studentUid &&
        data.relationship in ['parent', 'guardian', 'mentor'] &&
        data.status in ['pending', 'verified', 'revoked'] &&
        data.permissions is map &&
        data.permissions.keys().hasAll(['canViewProgress', 'canViewGoals', 'canViewAssessments', 'canReceiveAlerts']) &&
        data.permissions.keys().hasOnly(['canViewProgress', 'canViewGoals', 'canViewAssessments', 'canReceiveAlerts']) &&
        data.permissions.canViewProgress is bool &&
        data.permissions.canViewGoals is bool &&
        data.permissions.canViewAssessments is bool &&
        data.permissions.canReceiveAlerts is bool;
    }

    function isValidBoardRecord(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'fullName', 'type']) &&
        data.keys().hasOnly(['id', 'code', 'name', 'fullName', 'type', 'state', 'officialWebsite', 'isVerified', 'createdAt']) &&
        data.id is string && data.id.size() <= 64 &&
        data.code is string && data.code.size() <= 32 &&
        data.name is string && data.name.size() <= 100 &&
        data.fullName is string && data.fullName.size() <= 200 &&
        data.type in ['national', 'state', 'international'];
    }

    function isValidClassRecord(data) {
      return data.keys().hasAll(['id', 'boardId', 'grade']) &&
        data.keys().hasOnly(['id', 'boardId', 'grade', 'stream', 'academicYear', 'isVerified']) &&
        data.id is string && data.id.size() <= 64 &&
        data.boardId is string && data.boardId.size() <= 64 &&
        data.grade is string && data.grade.size() <= 30;
    }

    function isValidSubjectRecord(data) {
      return data.keys().hasAll(['id', 'boardId', 'classGrade', 'name']) &&
        data.keys().hasOnly(['id', 'boardId', 'classGrade', 'name', 'code', 'icon', 'color', 'category', 'isVerified']) &&
        data.id is string && data.id.size() <= 64 &&
        data.boardId is string && data.boardId.size() <= 64 &&
        data.name is string && data.name.size() <= 100;
    }

    function isValidSyllabusNode(data) {
      return data.keys().hasAll(['id', 'boardId', 'classGrade', 'subjectId', 'chapterNumber', 'chapterTitle', 'isVerified']) &&
        data.keys().hasOnly(['id', 'boardId', 'classGrade', 'subjectId', 'chapterNumber', 'chapterTitle', 'topics', 'version', 'isVerified', 'verifiedBy', 'sourceDoc']) &&
        data.id is string && data.id.size() <= 128 &&
        data.boardId is string && data.boardId.size() <= 64 &&
        data.chapterNumber is int &&
        data.chapterTitle is string && data.chapterTitle.size() <= 200;
    }

    function isValidLearningProfile(data) {
      return data.keys().hasAll(['id', 'userId', 'preferredPace', 'dailyGoalMinutes', 'dailyQuestionsTarget']) &&
        data.keys().hasOnly(['id', 'userId', 'preferredPace', 'strengths', 'weaknesses', 'dailyGoalMinutes', 'dailyQuestionsTarget', 'lastActiveDate', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.preferredPace in ['steady', 'accelerated', 'revision-focus'] &&
        data.dailyGoalMinutes is int &&
        data.dailyQuestionsTarget is int;
    }

    function isValidStudyPlan(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'status']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'targetDate', 'subjectId', 'tasks', 'status', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.title is string && data.title.size() <= 150 &&
        data.status in ['active', 'completed', 'archived'];
    }

    function isValidActivityRecord(data) {
      return data.keys().hasAll(['id', 'userId', 'type', 'title', 'timestamp']) &&
        data.keys().hasOnly([
          'id', 'userId', 'type', 'title', 'description', 'subjectId',
          'chapter', 'topic', 'objectiveId', 'sourceModule', 'idempotencyKey',
          'localDateKey', 'xpEarned', 'timestamp'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.timestamp is string && data.timestamp.size() <= 64 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('subjectId' in data) || (data.subjectId is string && data.subjectId.size() <= 80)) &&
        (!('chapter' in data) || (data.chapter is string && data.chapter.size() <= 160)) &&
        (!('topic' in data) || (data.topic is string && data.topic.size() <= 160)) &&
        (!('objectiveId' in data) || (data.objectiveId is string && data.objectiveId.size() <= 80)) &&
        (!('sourceModule' in data) || (data.sourceModule is string && data.sourceModule.size() <= 40)) &&
        (!('idempotencyKey' in data) || (data.idempotencyKey is string && data.idempotencyKey.size() <= 160)) &&
        (!('localDateKey' in data) || (data.localDateKey is string && data.localDateKey.size() <= 16)) &&
        (!('xpEarned' in data) || (data.xpEarned is int && data.xpEarned >= 0 && data.xpEarned <= 300)) &&
        data.type in [
          'doubt_asked', 'practice_completed', 'topic_studied', 'goal_achieved', 'revision_due',
          'lesson_started', 'lesson_completed', 'topic_completed', 'doubt_submitted',
          'practice_attempted', 'flashcard_reviewed', 'revision_completed',
          'exam_attempted', 'study_goal_completed', 'mindmap_created', 'voice_turn'
        ];
    }

    function isValidLessonProgress(data) {
      return data.keys().hasAll(['id', 'userId', 'subject', 'chapter', 'topic', 'status', 'startedAt']) &&
        data.keys().hasOnly([
          'id', 'userId', 'subject', 'chapter', 'topic', 'status',
          'lastSourceModule', 'startedAt', 'completedAt'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.subject is string && data.subject.size() > 0 && data.subject.size() <= 80 &&
        data.chapter is string && data.chapter.size() > 0 && data.chapter.size() <= 160 &&
        data.topic is string && data.topic.size() > 0 && data.topic.size() <= 160 &&
        data.status in ['started', 'completed'] &&
        data.startedAt is string && data.startedAt.size() <= 64 &&
        (!('lastSourceModule' in data) || (data.lastSourceModule is string && data.lastSourceModule.size() <= 40)) &&
        (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 64));
    }

    function isValidRecommendationHistory(data) {
      return data.keys().hasAll(['id', 'userId', 'recId', 'status', 'lastShownAt']) &&
        data.keys().hasOnly([
          'id', 'userId', 'recId', 'subject', 'chapter', 'topic', 'category',
          'status', 'shownCount', 'lastShownAt', 'completedAt', 'skippedAt', 'cooldownUntil'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.recId is string && data.recId.size() > 0 && data.recId.size() <= 128 &&
        data.status in ['shown', 'started', 'completed', 'skipped'] &&
        data.lastShownAt is string && data.lastShownAt.size() <= 64 &&
        (!('subject' in data) || (data.subject is string && data.subject.size() <= 80)) &&
        (!('chapter' in data) || (data.chapter is string && data.chapter.size() <= 160)) &&
        (!('topic' in data) || (data.topic is string && data.topic.size() <= 160)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 40)) &&
        (!('shownCount' in data) || (data.shownCount is int && data.shownCount >= 0 && data.shownCount <= 10000)) &&
        (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 64)) &&
        (!('skippedAt' in data) || (data.skippedAt is string && data.skippedAt.size() <= 64)) &&
        (!('cooldownUntil' in data) || (data.cooldownUntil is string && data.cooldownUntil.size() <= 64));
    }

    function isValidDailyGoalRecord(data) {
      return data.keys().hasAll(['id', 'userId', 'localDateKey', 'goalKey', 'title', 'completed']) &&
        data.keys().hasOnly([
          'id', 'userId', 'localDateKey', 'goalKey', 'title', 'category',
          'targetCount', 'currentCount', 'completed', 'completedAt', 'xpReward', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.localDateKey is string && data.localDateKey.size() > 0 && data.localDateKey.size() <= 16 &&
        data.goalKey is string && data.goalKey.size() > 0 && data.goalKey.size() <= 64 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.completed is bool &&
        (!('category' in data) || (data.category is string && data.category.size() <= 40)) &&
        (!('targetCount' in data) || (data.targetCount is int && data.targetCount >= 1 && data.targetCount <= 100)) &&
        (!('currentCount' in data) || (data.currentCount is int && data.currentCount >= 0 && data.currentCount <= 100)) &&
        (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 64)) &&
        (!('xpReward' in data) || (data.xpReward is int && data.xpReward >= 0 && data.xpReward <= 300)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidDoubtTicket(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'subject', 'questionText', 'status']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'subject', 'topic', 'classGrade', 'board', 'inputMode', 'attachmentLabel', 'questionText', 'language', 'status', 'aiAnswer', 'structuredSolution', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.subject is string && data.subject.size() > 0 && data.subject.size() <= 80 &&
        data.questionText is string && data.questionText.size() > 0 && data.questionText.size() <= 3000 &&
        data.status in ['open', 'answered', 'closed'] &&
        (!('topic' in data) || (data.topic is string && data.topic.size() <= 150)) &&
        (!('classGrade' in data) || (data.classGrade is string && data.classGrade.size() <= 30)) &&
        (!('board' in data) || (data.board is string && data.board.size() <= 32)) &&
        (!('language' in data) || (data.language is string && data.language.size() <= 30)) &&
        (!('attachmentLabel' in data) || (data.attachmentLabel is string && data.attachmentLabel.size() <= 160)) &&
        (!('aiAnswer' in data) || (data.aiAnswer is string && data.aiAnswer.size() <= 10000)) &&
        (!('inputMode' in data) || data.inputMode in ['typed', 'image', 'handwritten', 'pdf', 'worksheet']) &&
        (!('structuredSolution' in data) || data.structuredSolution is map);
    }

    function isValidTeacherSession(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'subject', 'classGrade', 'board', 'language', 'difficultyLevel', 'teachingMode', 'messages']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'subject', 'classGrade', 'board', 'language', 'difficultyLevel', 'teachingMode', 'messages', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.subject is string && data.subject.size() > 0 && data.subject.size() <= 100 &&
        data.classGrade is string && data.classGrade.size() > 0 && data.classGrade.size() <= 30 &&
        data.board is string && data.board.size() > 0 && data.board.size() <= 32 &&
        data.language in ['English', 'Hindi', 'Bilingual', 'Hinglish'] &&
        data.difficultyLevel in ['Beginner', 'Intermediate', 'Advanced'] &&
        data.teachingMode in ['explain', 'step-by-step', 'examples', 'explain-mistake', 'test-understanding', 'summarize-chapter'] &&
        data.messages is list && data.messages.size() <= 40 &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidMindMap(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'topic', 'subject', 'classGrade', 'board', 'language', 'nodes']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'topic', 'subject', 'classGrade', 'board', 'language', 'syllabusStatus', 'summary', 'syllabusNote', 'nodes', 'crossLinks', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.topic is string && data.topic.size() > 0 && data.topic.size() <= 200 &&
        data.subject is string && data.subject.size() > 0 && data.subject.size() <= 100 &&
        data.classGrade is string && data.classGrade.size() > 0 && data.classGrade.size() <= 30 &&
        data.board is string && data.board.size() > 0 && data.board.size() <= 32 &&
        data.language in ['English', 'Hindi', 'Bilingual'] &&
        (!('syllabusStatus' in data) || data.syllabusStatus in ['verified', 'sample', 'custom']) &&
        (!('summary' in data) || (data.summary is string && data.summary.size() <= 1000)) &&
        (!('syllabusNote' in data) || (data.syllabusNote is string && data.syllabusNote.size() <= 600)) &&
        data.nodes is list && data.nodes.size() > 0 && data.nodes.size() <= 60 &&
        (!('crossLinks' in data) || (data.crossLinks is list && data.crossLinks.size() <= 20));
    }

    function isValidVisualExploration(data) {
      return data.keys().hasAll([
          'id', 'cacheKey', 'userId', 'board', 'classGrade', 'subject', 'chapter',
          'topic', 'language', 'title', 'visualCategory', 'rendererType',
          'steps', 'engineConfig', 'saved', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'cacheKey', 'userId', 'board', 'classGrade', 'subject', 'chapter',
          'topic', 'customPrompt', 'language', 'title', 'subtitle', 'visualCategory',
          'rendererType', 'modalityHonestyLabel', 'conceptExplanation',
          'whatYouAreObserving', 'interactionInstructions', 'formulaOrLaw',
          'keyTakeaways', 'observationsChecklist', 'steps', 'engineConfig',
          'saved', 'cached', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.cacheKey is string && data.cacheKey.size() > 0 && data.cacheKey.size() <= 240 &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.board is string && data.board.size() > 0 && data.board.size() <= 32 &&
        data.classGrade is string && data.classGrade.size() > 0 && data.classGrade.size() <= 30 &&
        data.subject is string && data.subject.size() > 0 && data.subject.size() <= 80 &&
        data.chapter is string && data.chapter.size() > 0 && data.chapter.size() <= 160 &&
        data.topic is string && data.topic.size() > 0 && data.topic.size() <= 180 &&
        (!('customPrompt' in data) || (data.customPrompt is string && data.customPrompt.size() <= 400)) &&
        data.language in ['English', 'Hindi'] &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 240)) &&
        data.visualCategory in [
          'physics-simulation', 'math-graph', 'geometry-construction',
          'chemistry-model', 'annotated-diagram', 'process-cycle', 'illustrated-concept'
        ] &&
        data.rendererType in [
          'kinematics-projectile', 'optics-ray', 'circuit-network', 'wave-oscillation',
          'bohr-atom', 'molecular-geometry', 'math-function-plot', 'coordinate-geometry',
          'annotated-diagram', 'illustrated-concept'
        ] &&
        (!('modalityHonestyLabel' in data) || (data.modalityHonestyLabel is string && data.modalityHonestyLabel.size() <= 260)) &&
        (!('conceptExplanation' in data) || (data.conceptExplanation is string && data.conceptExplanation.size() <= 1500)) &&
        (!('whatYouAreObserving' in data) || (data.whatYouAreObserving is string && data.whatYouAreObserving.size() <= 800)) &&
        (!('interactionInstructions' in data) || (data.interactionInstructions is string && data.interactionInstructions.size() <= 500)) &&
        (!('formulaOrLaw' in data) || (data.formulaOrLaw is string && data.formulaOrLaw.size() <= 200)) &&
        (!('keyTakeaways' in data) || (data.keyTakeaways is list && data.keyTakeaways.size() <= 10 && (data.keyTakeaways.size() == 0 || data.keyTakeaways[0] is string))) &&
        (!('observationsChecklist' in data) || (data.observationsChecklist is list && data.observationsChecklist.size() <= 10 && (data.observationsChecklist.size() == 0 || data.observationsChecklist[0] is string))) &&
        data.steps is list && data.steps.size() >= 1 && data.steps.size() <= 10 && data.steps[0] is map &&
        data.engineConfig is map &&
        data.saved is bool &&
        (!('cached' in data) || data.cached is bool) &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidPracticeRecord(data) {
      return data.keys().hasAll(['id', 'userId', 'subject', 'topic', 'score', 'totalQuestions', 'accuracyRate']) &&
        data.keys().hasOnly(['id', 'userId', 'subject', 'topic', 'score', 'totalQuestions', 'accuracyRate', 'timeSpentSeconds', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.subject is string && data.subject.size() <= 80 &&
        data.topic is string && data.topic.size() <= 120 &&
        data.score is int &&
        data.totalQuestions is int;
    }

    function isValidPracticeAttempt(data) {
      return data.keys().hasAll(['id', 'userId', 'subject', 'topic', 'questionType', 'difficulty', 'isCorrect', 'timeSpentSeconds', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'userId', 'subject', 'chapter', 'topic', 'board', 'classGrade',
          'questionId', 'questionType', 'difficulty', 'prompt', 'userAnswer',
          'correctAnswer', 'isCorrect', 'scoreRatio', 'timeSpentSeconds',
          'errorTag', 'misconceptionNote', 'createdAt'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.subject is string && data.subject.size() > 0 && data.subject.size() <= 80 &&
        data.topic is string && data.topic.size() > 0 && data.topic.size() <= 160 &&
        data.questionType in ['mcq', 'true-false', 'fill-blank', 'short-answer', 'numerical'] &&
        data.difficulty in ['foundation', 'intermediate', 'board-challenge'] &&
        data.isCorrect is bool &&
        data.timeSpentSeconds is int && data.timeSpentSeconds >= 0 && data.timeSpentSeconds <= 7200 &&
        (!('chapter' in data) || (data.chapter is string && data.chapter.size() <= 160)) &&
        (!('board' in data) || (data.board is string && data.board.size() <= 32)) &&
        (!('classGrade' in data) || (data.classGrade is string && data.classGrade.size() <= 30)) &&
        (!('questionId' in data) || (data.questionId is string && data.questionId.size() <= 128)) &&
        (!('prompt' in data) || (data.prompt is string && data.prompt.size() <= 1200)) &&
        (!('userAnswer' in data) || (data.userAnswer is string && data.userAnswer.size() <= 1000)) &&
        (!('correctAnswer' in data) || (data.correctAnswer is string && data.correctAnswer.size() <= 1000)) &&
        (!('errorTag' in data) || (data.errorTag is string && data.errorTag.size() <= 80)) &&
        (!('misconceptionNote' in data) || (data.misconceptionNote is string && data.misconceptionNote.size() <= 600));
    }

    function isValidTopicMastery(data) {
      return data.keys().hasAll(['id', 'userId', 'subject', 'topic', 'attemptsCount', 'correctCount', 'weightedMasteryScore', 'status', 'currentRecommendedDifficulty']) &&
        data.keys().hasOnly([
          'id', 'userId', 'subject', 'chapter', 'topic', 'attemptsCount', 'correctCount',
          'recentAccuracy', 'weightedMasteryScore', 'status', 'currentRecommendedDifficulty',
          'totalTimeSpentSeconds', 'recurringErrors', 'revisionCount', 'lastPracticedAt',
          'lastRevisedAt', 'historySnapshots', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
