    // Phase 7: Collaborative Study Rooms & Motivation Helpers
    function isStudyRoomHost(roomId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/study_rooms/$(roomId)) &&
        get(/databases/$(database)/documents/study_rooms/$(roomId)).data.hostUid == request.auth.uid
      );
    }

    function isActiveRoomMember(roomId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/study_rooms/$(roomId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/study_rooms/$(roomId)/members/$(request.auth.uid)).data.status != 'removed'
      );
    }

    function canPostInRoom(roomId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/study_rooms/$(roomId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/study_rooms/$(roomId)/members/$(request.auth.uid)).data.status == 'active'
      );
    }

    function isRoomModerator(roomId) {
      return isSignedIn() && (
        isStudyRoomHost(roomId) || (
          exists(/databases/$(database)/documents/study_rooms/$(roomId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/study_rooms/$(roomId)/members/$(request.auth.uid)).data.status == 'active' &&
          get(/databases/$(database)/documents/study_rooms/$(roomId)/members/$(request.auth.uid)).data.role in ['host', 'moderator']
        )
      );
    }

