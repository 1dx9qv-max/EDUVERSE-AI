    }

    function isValidAdminAuditLog(data) {
      return data.keys().hasAll(['id', 'actorUid', 'actorEmail', 'actorRole', 'action', 'targetType', 'targetId', 'summary', 'createdAt']) &&
        data.keys().hasOnly(['id', 'actorUid', 'actorEmail', 'actorRole', 'action', 'targetType', 'targetId', 'summary', 'createdAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.actorUid is string && data.actorUid.size() > 0 && data.actorUid.size() <= 128 &&
        data.actorEmail is string && data.actorEmail.size() > 0 && data.actorEmail.size() <= 256 &&
        data.actorRole == 'admin' &&
        data.action is string && data.action.size() > 0 && data.action.size() <= 100 &&
        data.targetType is string && data.targetType.size() > 0 && data.targetType.size() <= 40 &&
        data.targetId is string && data.targetId.size() > 0 && data.targetId.size() <= 128 &&
        data.summary is string && data.summary.size() > 0 && data.summary.size() <= 400 &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidGuardianInviteCode(data) {
      return data.keys().hasAll(['code', 'studentUid', 'createdAt', 'expiresAt', 'used']) &&
        data.keys().hasOnly(['code', 'studentUid', 'studentDisplayName', 'createdAt', 'expiresAt', 'used']) &&
        data.code is string && data.code.size() >= 6 && data.code.size() <= 64 &&
        data.studentUid is string && data.studentUid.size() > 0 && data.studentUid.size() <= 128 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.expiresAt is string && data.expiresAt.size() <= 64 &&
        data.used is bool;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'createdAt']) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
        data.role == 'admin';
    }

    // Rules for Unique Username Registry (atomic handle claims; listing disabled)
    match /usernames/{username} {
      allow get: if isSignedIn() && isValidUsernameId(username);
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidUsernameId(username) &&
        isValidUsernameClaim(incoming()) &&
        incoming().username == username &&
        incoming().uid == request.auth.uid &&
        !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if false;
      allow delete: if (isVerifiedUser() && existing().uid == request.auth.uid) || isAdmin();
    }

    // Rules for User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isVerifiedGuardianOf(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isVerifiedUser() &&
        isOwner(userId) &&
        isValidId(userId) &&
        incoming().uid == request.auth.uid &&
        (incoming().role in ['student', 'guardian'] || isAdmin()) &&
        (!('status' in incoming()) || incoming().status == 'active') &&
        (isAdmin() || (
          (!('streakDays' in incoming()) || incoming().streakDays <= 1) &&
          (!('xpPoints' in incoming()) || incoming().xpPoints <= 100)
        )) &&
        (!('username' in incoming()) || getAfter(/databases/$(database)/documents/usernames/$(incoming().username)).data.uid == userId) &&
        isValidUserProfile(incoming());
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid && (
          isAdmin() || (
            isOwner(userId) &&
            incoming().role == existing().role &&
            (!('status' in existing()) || incoming().status == existing().status) &&
            incoming().streakDays == existing().streakDays &&
            incoming().xpPoints == existing().xpPoints &&
            (!('username' in incoming()) || (('username' in existing()) && incoming().username == existing().username) || getAfter(/databases/$(database)/documents/usernames/$(incoming().username)).data.uid == userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'username', 'displayName', 'avatarId', 'emailVerified', 'authProvider', 'board', 'classGrade', 'state', 'language', 'subjects', 'learningGoals', 'onboardingCompleted', 'updatedAt', 'photoURL'
            ])
          )
        );
      allow delete: if (isVerifiedUser() && isOwner(userId)) || isAdmin();

      // User's private joined study room index (prevents public room directory scraping)
      match /study_memberships/{roomId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update: if isVerifiedUser() && isOwner(userId) && isValidId(roomId) && isValidStudyMembershipIndex(incoming()) && incoming().roomId == roomId;
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // Rules for Guardians Link collection (student approval mandatory; guardians cannot self-verify)
    match /guardians/{guardianLinkId} {
      allow get: if isSignedIn() && isValidId(guardianLinkId) && (existing().guardianUid == request.auth.uid || existing().studentUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.guardianUid == request.auth.uid || resource.data.studentUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(guardianLinkId) &&
        isValidGuardianLink(incoming()) &&
        incoming().id == guardianLinkId &&
        guardianLinkId == (incoming().guardianUid + '_' + incoming().studentUid) && (
          isAdmin() || (
            incoming().guardianUid == request.auth.uid &&
            incoming().status == 'pending'
          )
        );
      allow update: if isVerifiedUser() &&
        isValidId(guardianLinkId) &&
        isValidGuardianLink(incoming()) &&
        incoming().id == existing().id &&
        incoming().guardianUid == existing().guardianUid &&
        incoming().studentUid == existing().studentUid &&
        (existing().studentUid == request.auth.uid || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'relationship', 'permissions', 'verifiedAt', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(guardianLinkId) && (existing().guardianUid == request.auth.uid || existing().studentUid == request.auth.uid || isAdmin());
    }

    // Rules for Curriculum: Boards
    match /boards/{boardId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidBoardRecord(incoming());
    }

    // Rules for Curriculum: Classes
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidClassRecord(incoming());
    }

    // Rules for Curriculum: Subjects
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidSubjectRecord(incoming());
    }

    // Rules for Curriculum: Syllabus nodes (Verified by Admins)
    match /syllabus/{syllabusId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidSyllabusNode(incoming());
    }

    // Rules for Learning Profiles (Goals summary gated by canViewGoals)
    match /learning_profiles/{profileId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isVerifiedGuardianWithPermission(existing().userId, 'canViewGoals') || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(profileId) &&
        incoming().userId == request.auth.uid &&
        isValidLearningProfile(incoming());
      allow update: if isVerifiedUser() &&
        isValidLearningProfile(incoming()) &&
        incoming().userId == existing().userId &&
        (existing().userId == request.auth.uid || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'preferredPace', 'strengths', 'weaknesses', 'dailyGoalMinutes', 'dailyQuestionsTarget', 'lastActiveDate', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Rules for Study Plans (Goals summary gated by canViewGoals)
    match /study_plans/{planId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isVerifiedGuardianWithPermission(existing().userId, 'canViewGoals') || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(planId) &&
        incoming().userId == request.auth.uid &&
        isValidStudyPlan(incoming());
      allow update: if isVerifiedUser() &&
        isValidStudyPlan(incoming()) &&
        incoming().userId == existing().userId &&
        (existing().userId == request.auth.uid || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'targetDate', 'subjectId', 'tasks', 'status', 'updatedAt']);
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Rules for Activities
    match /activities/{activityId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isVerifiedGuardianWithPermission(existing().userId, 'canViewProgress') || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(activityId) &&
        incoming().userId == request.auth.uid &&
        isValidActivityRecord(incoming());
      allow update: if isAdmin();
      allow delete: if isSignedIn() && isValidId(activityId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Rules for Doubt Tickets (PRIVATE to student & admin; NEVER readable by guardians)
    match /doubts/{doubtId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(doubtId) &&
        incoming().userId == request.auth.uid &&
        isValidDoubtTicket(incoming());
      allow update: if isVerifiedUser() &&
        isValidId(doubtId) &&
        isValidDoubtTicket(incoming()) &&
        incoming().userId == existing().userId &&
        (existing().userId == request.auth.uid || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'topic', 'questionText', 'status', 'aiAnswer', 'structuredSolution', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(doubtId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Rules for Personal AI Teacher Sessions (PRIVATE to student & admin; NEVER readable by guardians)
    match /teacher_sessions/{sessionId} {
      allow get: if isSignedIn() && isValidId(sessionId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(sessionId) &&
        incoming().id == sessionId &&
        incoming().userId == request.auth.uid &&
        isValidTeacherSession(incoming());
      allow update: if isVerifiedUser() &&
        isValidId(sessionId) &&
        isValidTeacherSession(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        (existing().userId == request.auth.uid || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'subject', 'classGrade', 'board', 'language', 'difficultyLevel', 'teachingMode', 'messages', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(sessionId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Rules for Interactive Mind Maps (PRIVATE to student & admin)
    match /mindmaps/{mindMapId} {
      allow get: if isSignedIn() && isValidId(mindMapId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(mindMapId) &&
        incoming().userId == request.auth.uid &&
        incoming().id == mindMapId &&
        isValidMindMap(incoming());
      allow update: if isVerifiedUser() &&
        isValidId(mindMapId) &&
        isValidMindMap(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        (existing().userId == request.auth.uid || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'topic', 'subject', 'classGrade', 'board', 'language', 'syllabusStatus', 'summary', 'syllabusNote', 'nodes', 'crossLinks', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(mindMapId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Rules for Practice Records (Gated by canViewAssessments)
    match /practiceRecords/{recordId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isVerifiedGuardianWithPermission(existing().userId, 'canViewAssessments') || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(recordId) &&
        incoming().userId == request.auth.uid &&
        isValidPracticeRecord(incoming());
      allow update: if isAdmin();
      allow delete: if isSignedIn() && isValidId(recordId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Rules for Per-Question Adaptive Practice Attempts (Gated by canViewAssessments)
    match /practice_attempts/{attemptId} {
      allow get: if isSignedIn() && isValidId(attemptId) && (existing().userId == request.auth.uid || isVerifiedGuardianWithPermission(existing().userId, 'canViewAssessments') || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(attemptId) &&
        incoming().userId == request.auth.uid &&
        incoming().id == attemptId &&
        isValidPracticeAttempt(incoming());
      allow update: if isAdmin();
      allow delete: if isSignedIn() && isValidId(attemptId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Rules for Topic Mastery Analytics (Gated by canViewProgress)
    match /topic_mastery/{masteryId} {
      allow get: if isSignedIn() && isValidId(masteryId) && (existing().userId == request.auth.uid || isVerifiedGuardianWithPermission(existing().userId, 'canViewProgress') || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(masteryId) &&
        incoming().userId == request.auth.uid &&
        incoming().id == masteryId &&
        isValidTopicMastery(incoming());
      allow update: if isVerifiedUser() &&
        isValidId(masteryId) &&
        isValidTopicMastery(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        (existing().userId == request.auth.uid || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'chapter', 'attemptsCount', 'correctCount', 'recentAccuracy',
          'weightedMasteryScore', 'status', 'currentRecommendedDifficulty',
          'totalTimeSpentSeconds', 'recurringErrors', 'revisionCount',
          'lastPracticedAt', 'lastRevisedAt', 'historySnapshots', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(masteryId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Rules for Spaced Repetition Flashcards (PRIVATE to student & admin)
    match /flashcards/{cardId} {
      allow get: if isSignedIn() && isValidId(cardId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(cardId) &&
        incoming().userId == request.auth.uid &&
        incoming().id == cardId &&
        isValidFlashcard(incoming());
      allow update: if isVerifiedUser() &&
        isValidId(cardId) &&
        isValidFlashcard(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        (existing().userId == request.auth.uid || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'subject', 'chapter', 'topic', 'front', 'back', 'hint',
          'linkedErrorTag', 'difficultyTag', 'repetitions', 'intervalDays',
          'easeFactor', 'lapses', 'dueDate', 'lastReviewedAt', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(cardId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Rules for Flashcard Revision History (PRIVATE to student & admin)
    match /flashcard_reviews/{reviewId} {
      allow get: if isSignedIn() && isValidId(reviewId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(reviewId) &&
        incoming().userId == request.auth.uid &&
        incoming().id == reviewId &&
        isValidFlashcardReview(incoming());
      allow update: if isAdmin();
      allow delete: if isSignedIn() && isValidId(reviewId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Rules for Exam Simulator Attempts (Gated by canViewAssessments; immutable to students after submission)
    match /exam_attempts/{attemptId} {
      allow get: if isSignedIn() && isValidId(attemptId) && (existing().userId == request.auth.uid || isVerifiedGuardianWithPermission(existing().userId, 'canViewAssessments') || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(attemptId) &&
        incoming().userId == request.auth.uid &&
        incoming().id == attemptId &&
        isValidExamAttempt(incoming());
      allow update: if isAdmin() &&
        isValidId(attemptId) &&
        isValidExamAttempt(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(attemptId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Rules for Voice Classroom Text Transcripts (PRIVATE to student & admin; NEVER readable by guardians)
    match /voice_sessions/{sessionId} {
      allow get: if isSignedIn() && isValidId(sessionId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        isValidId(sessionId) &&
        incoming().userId == request.auth.uid &&
        incoming().id == sessionId &&
        isValidVoiceSession(incoming());
      allow update: if isSignedIn() &&
        isValidId(sessionId) &&
        isValidVoiceSession(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        (existing().userId == request.auth.uid || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'subject', 'topic', 'language', 'voiceName', 'transportUsed', 'turns', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(sessionId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Rules for Phase 7: Private Study Rooms (invitation-only, no public directory, DMs disabled)
    match /study_rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId) && (isActiveRoomMember(roomId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.hostUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        isValidId(roomId) &&
        incoming().id == roomId &&
        incoming().hostUid == request.auth.uid &&
        isValidStudyRoom(incoming());
      allow update: if isSignedIn() &&
        isValidId(roomId) &&
        (isStudyRoomHost(roomId) || isAdmin()) &&
        isValidStudyRoom(incoming()) &&
        incoming().id == existing().id &&
        incoming().hostUid == existing().hostUid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'topic', 'inviteCode', 'isLocked', 'maxMembers', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(roomId) && (isStudyRoomHost(roomId) || isAdmin());

      match /members/{memberUid} {
        allow get, list: if isSignedIn() && (isActiveRoomMember(roomId) || isStudyRoomHost(roomId) || isAdmin());
        allow create: if isSignedIn() &&
          isValidId(memberUid) &&
          incoming().uid == memberUid &&
          incoming().roomId == roomId &&
          isValidStudyRoomMember(incoming()) &&
          (
            (isStudyRoomHost(roomId) && memberUid == request.auth.uid && incoming().role == 'host') ||
            (memberUid == request.auth.uid && incoming().role == 'member' && incoming().status == 'active') ||
            isAdmin()
          );
        allow update: if isSignedIn() &&
          isValidId(memberUid) &&
          isValidStudyRoomMember(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().roomId == existing().roomId &&
          (
            isRoomModerator(roomId) ||
            isAdmin() ||
            (
              memberUid == request.auth.uid &&
              existing().status == 'active' &&
              incoming().role == existing().role &&
              incoming().status == existing().status &&
              incoming().diff(existing()).affectedKeys().hasOnly(['contributionsCount', 'quizPoints', 'lastActiveAt'])
            )
          );
        allow delete: if isSignedIn() && (isStudyRoomHost(roomId) || memberUid == request.auth.uid || isAdmin());
      }

      match /notes/{noteId} {
        allow get, list: if isSignedIn() && (isActiveRoomMember(roomId) || isAdmin());
        allow create: if isSignedIn() &&
          isValidId(noteId) &&
          canPostInRoom(roomId) &&
          incoming().id == noteId &&
          incoming().roomId == roomId &&
          incoming().authorUid == request.auth.uid &&
          incoming().status == 'visible' &&
          isValidStudyRoomNote(incoming());
        allow update: if isSignedIn() &&
          isValidId(noteId) &&
          isValidStudyRoomNote(incoming()) &&
          incoming().id == existing().id &&
          incoming().roomId == existing().roomId &&
          incoming().authorUid == existing().authorUid &&
          (
            isRoomModerator(roomId) ||
            isAdmin() ||
            (
              existing().authorUid == request.auth.uid &&
              canPostInRoom(roomId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'topic', 'updatedAt'])
            ) ||
            (
              isActiveRoomMember(roomId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reportCount', 'reportedBy', 'updatedAt'])
            )
          );
        allow delete: if isSignedIn() && (existing().authorUid == request.auth.uid || isRoomModerator(roomId) || isAdmin());
      }

      match /goals/{goalId} {
        allow get, list: if isSignedIn() && (isActiveRoomMember(roomId) || isAdmin());
        allow create: if isSignedIn() &&
          isValidId(goalId) &&
          canPostInRoom(roomId) &&
          incoming().id == goalId &&
          incoming().roomId == roomId &&
          incoming().createdByUid == request.auth.uid &&
          isValidStudyRoomGoal(incoming());
        allow update: if isSignedIn() &&
          isValidId(goalId) &&
          canPostInRoom(roomId) &&
          isValidStudyRoomGoal(incoming()) &&
          incoming().id == existing().id &&
          incoming().roomId == existing().roomId &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['currentCount', 'contributorUids', 'completed', 'updatedAt']);
        allow delete: if isSignedIn() && (existing().createdByUid == request.auth.uid || isRoomModerator(roomId) || isAdmin());
      }

      match /quizzes/{quizId} {
        allow get, list: if isSignedIn() && (isActiveRoomMember(roomId) || isAdmin());
        allow create: if isSignedIn() &&
          isValidId(quizId) &&
          canPostInRoom(roomId) &&
          incoming().id == quizId &&
          incoming().roomId == roomId &&
          incoming().createdByUid == request.auth.uid &&
          isValidStudyRoomQuiz(incoming());
        allow update: if isSignedIn() &&
          isValidId(quizId) &&
          isActiveRoomMember(roomId) &&
          isValidStudyRoomQuiz(incoming()) &&
          incoming().id == existing().id &&
          incoming().roomId == existing().roomId &&
          incoming().createdByUid == existing().createdByUid &&
          (
            isRoomModerator(roomId) ||
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly(['submissions'])
          );
        allow delete: if isSignedIn() && (existing().createdByUid == request.auth.uid || isRoomModerator(roomId) || isAdmin());
      }

      match /mindmaps/{mapId} {
        allow get, list: if isSignedIn() && (isActiveRoomMember(roomId) || isAdmin());
        allow create: if isSignedIn() &&
          isValidId(mapId) &&
          canPostInRoom(roomId) &&
          incoming().id == mapId &&
          incoming().roomId == roomId &&
          incoming().sharedByUid == request.auth.uid &&
          isValidStudyRoomMindMap(incoming());
        allow update: if isSignedIn() &&
          isValidId(mapId) &&
          isActiveRoomMember(roomId) &&
          isValidStudyRoomMindMap(incoming()) &&
          incoming().id == existing().id &&
          incoming().roomId == existing().roomId &&
          incoming().sharedByUid == existing().sharedByUid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['endorsements']);
        allow delete: if isSignedIn() && (existing().sharedByUid == request.auth.uid || isRoomModerator(roomId) || isAdmin());
      }

      match /reports/{reportId} {
        allow get, list: if isSignedIn() && (isRoomModerator(roomId) || resource.data.reporterUid == request.auth.uid || isAdmin());
        allow create: if isSignedIn() &&
          isValidId(reportId) &&
          isActiveRoomMember(roomId) &&
          incoming().id == reportId &&
          incoming().roomId == roomId &&
          incoming().reporterUid == request.auth.uid &&
          incoming().status == 'open' &&
          isValidStudyRoomReport(incoming());
        allow update: if isSignedIn() &&
          isValidId(reportId) &&
          (isRoomModerator(roomId) || isAdmin()) &&
          isValidStudyRoomReport(incoming()) &&
          incoming().id == existing().id &&
          incoming().roomId == existing().roomId &&
          incoming().reporterUid == existing().reporterUid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resolvedByUid', 'resolvedAt']);
        allow delete: if isAdmin();
      }
    }

    // Secret Invite Lookup (get by exact secret code only; listing disabled for non-admins)
    match /study_room_invites/{inviteCode} {
      allow get: if isSignedIn() && isValidId(inviteCode);
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
        isValidId(inviteCode) &&
        incoming().code == inviteCode &&
        incoming().createdByUid == request.auth.uid &&
        isStudyRoomHost(incoming().roomId) &&
        isValidStudyRoomInvite(incoming());
      allow update: if isSignedIn() &&
        isValidId(inviteCode) &&
        isValidStudyRoomInvite(incoming()) &&
        incoming().code == existing().code &&
        incoming().roomId == existing().roomId &&
        incoming().createdByUid == existing().createdByUid &&
        (
          isStudyRoomHost(existing().roomId) ||
          isAdmin() ||
          (
            existing().revoked == false &&
            existing().usesCount < existing().maxUses &&
            incoming().diff(existing()).affectedKeys().hasOnly(['usesCount']) &&
            incoming().usesCount == existing().usesCount + 1
          )
        );
      allow delete: if isSignedIn() && (isStudyRoomHost(existing().roomId) || isAdmin());
    }

    // Rules for Verified Healthy Motivation & Achievement States
    match /achievement_states/{userId} {
      allow get: if isOwner(userId) || isVerifiedGuardianWithPermission(userId, 'canViewProgress') || isAdmin();
      allow list: if isAdmin();
      allow create: if isVerifiedUser() &&
        isOwner(userId) &&
        isValidId(userId) &&
        incoming().userId == request.auth.uid &&
        isValidAchievementState(incoming());
      allow update: if isVerifiedUser() &&
        isOwner(userId) &&
        isValidId(userId) &&
        isValidAchievementState(incoming()) &&
        incoming().userId == existing().userId;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Rules for Admin-Managed Question Bank
    match /question_bank/{questionId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(questionId) && incoming().id == questionId && isValidQuestionBankItem(incoming());
      allow delete: if isAdmin() && isValidId(questionId);
    }

    // Rules for Admin-Managed Learning Content
    match /learning_content/{contentId} {
      allow get: if isSignedIn() && isValidId(contentId) && (existing().status == 'published' || isAdmin());
      allow list: if isSignedIn() && (resource.data.status == 'published' || isAdmin());
      allow create, update: if isAdmin() && isValidId(contentId) && incoming().id == contentId && isValidLearningContent(incoming());
      allow delete: if isAdmin() && isValidId(contentId);
    }

    // Rules for Platform Moderation Reports
    match /moderation_reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (existing().reporterUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.reporterUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(reportId) &&
        incoming().id == reportId &&
        incoming().reporterUid == request.auth.uid &&
        incoming().status == 'open' &&
        isValidModerationReport(incoming());
      allow update: if isAdmin() &&
        isValidId(reportId) &&
        isValidModerationReport(incoming()) &&
        incoming().id == existing().id &&
        incoming().reporterUid == existing().reporterUid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resolvedByUid', 'resolvedAt']);
      allow delete: if isAdmin() && isValidId(reportId);
    }

    // Rules for Immutable Administrative Audit Logs
    match /admin_audit_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() &&
        isValidId(logId) &&
        incoming().id == logId &&
        incoming().actorUid == request.auth.uid &&
        isValidAdminAuditLog(incoming());
      allow update, delete: if false;
    }

    // Rules for Single-Use Expiring Guardian Invite Codes
    match /guardian_invite_codes/{code} {
      allow get: if isSignedIn() && isValidId(code);
      allow list: if isSignedIn() && (resource.data.studentUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(code) &&
        incoming().code == code &&
        incoming().studentUid == request.auth.uid &&
        incoming().used == false &&
        isValidGuardianInviteCode(incoming());
      allow update: if isVerifiedUser() &&
        isValidId(code) &&
        isValidGuardianInviteCode(incoming()) &&
        incoming().code == existing().code &&
        incoming().studentUid == existing().studentUid &&
        (
          isAdmin() ||
          (
            existing().used == false &&
            incoming().used == true &&
            incoming().diff(existing()).affectedKeys().hasOnly(['used'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(code) && (existing().studentUid == request.auth.uid || isAdmin());
    }

    // Rules for Admins collection (strict owner/admin PII protection)
    match /admins/{adminUid} {
      allow get: if isOwner(adminUid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(adminUid) && incoming().uid == adminUid && isValidAdminRecord(incoming());
      allow delete: if isAdmin() && isValidId(adminUid);
    }

    // Rules for UID-Scoped Lesson Progress
    match /lesson_progress/{progressId} {
      allow get: if isSignedIn() && isValidId(progressId) && (existing().userId == request.auth.uid || isVerifiedGuardianWithPermission(existing().userId, 'canViewProgress') || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(progressId) &&
        incoming().id == progressId &&
        incoming().userId == request.auth.uid &&
        isValidLessonProgress(incoming());
      allow update: if isVerifiedUser() &&
        isValidId(progressId) &&
        isValidLessonProgress(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        (existing().userId == request.auth.uid || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lastSourceModule', 'completedAt']);
      allow delete: if isSignedIn() && isValidId(progressId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Rules for UID-Scoped Adaptive Recommendation History
    match /recommendation_history/{historyId} {
      allow get: if isSignedIn() && isValidId(historyId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(historyId) &&
        incoming().id == historyId &&
        incoming().userId == request.auth.uid &&
        isValidRecommendationHistory(incoming());
      allow update: if isVerifiedUser() &&
        isValidId(historyId) &&
        isValidRecommendationHistory(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().recId == existing().recId &&
        (existing().userId == request.auth.uid || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'shownCount', 'lastShownAt', 'completedAt', 'skippedAt', 'cooldownUntil'
        ]);
      allow delete: if isSignedIn() && isValidId(historyId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Rules for UID-Scoped Daily Learning Goals
    match /daily_goals/{goalId} {
      allow get: if isSignedIn() && isValidId(goalId) && (existing().userId == request.auth.uid || isVerifiedGuardianWithPermission(existing().userId, 'canViewGoals') || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(goalId) &&
        incoming().id == goalId &&
        incoming().userId == request.auth.uid &&
        isValidDailyGoalRecord(incoming());
      allow update: if isVerifiedUser() &&
        isValidId(goalId) &&
        isValidDailyGoalRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().localDateKey == existing().localDateKey &&
        (existing().userId == request.auth.uid || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'currentCount', 'completed', 'completedAt', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(goalId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Rules for UID-Scoped AI Visual Learning Explorations (PRIVATE to student & admin)
    match /visual_explorations/{visualId} {
      allow get: if isSignedIn() && isValidId(visualId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(visualId) &&
        incoming().id == visualId &&
        incoming().userId == request.auth.uid &&
        isValidVisualExploration(incoming());
      allow update: if isVerifiedUser() &&
        isValidId(visualId) &&
        isValidVisualExploration(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        (existing().userId == request.auth.uid || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['saved', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(visualId) && (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
