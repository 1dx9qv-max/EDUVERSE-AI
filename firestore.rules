rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Authentication & Ownership Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsernameId(u) {
      return u is string && u.size() >= 3 && u.size() <= 24 && u.matches('^[a-z][a-z0-9_]{2,23}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validators
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'board', 'classGrade', 'language']) &&
        data.keys().hasOnly([
          'uid', 'email', 'emailVerified', 'authProvider', 'username', 'displayName',
          'avatarId', 'photoURL', 'role', 'status', 'board', 'classGrade', 'state',
          'language', 'subjects', 'learningGoals', 'onboardingCompleted',
          'streakDays', 'xpPoints', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        (!('username' in data) || isValidUsernameId(data.username)) &&
        (!('avatarId' in data) || (data.avatarId is string && data.avatarId.size() <= 48)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        (!('emailVerified' in data) || data.emailVerified is bool) &&
        (!('authProvider' in data) || data.authProvider in ['google', 'password']) &&
        data.role in ['student', 'admin'] &&
        (!('status' in data) || data.status in ['active', 'suspended']) &&
        data.board in ['CBSE', 'CISCE', 'ICSE', 'ISC', 'StateBoard', 'Other'] &&
        data.classGrade in ['Class 6', 'Class 7', 'Class 8', 'Class 9', 'Class 10', 'Class 11', 'Class 12'] &&
        (!('state' in data) || (data.state is string && data.state.size() <= 80)) &&
        data.language in ['English', 'Hindi', 'Hinglish', 'Bilingual'] &&
        (!('subjects' in data) || (data.subjects is list && data.subjects.size() <= 20)) &&
        (!('learningGoals' in data) || (data.learningGoals is list && data.learningGoals.size() <= 15)) &&
        (!('onboardingCompleted' in data) || data.onboardingCompleted is bool) &&
        (!('streakDays' in data) || (data.streakDays is int && data.streakDays >= 0)) &&
        (!('xpPoints' in data) || (data.xpPoints is int && data.xpPoints >= 0)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidUsernameClaim(data) {
      return data.keys().hasAll(['uid', 'username', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'username', 'createdAt']) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        isValidUsernameId(data.username) &&
        data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64;
    }

    function isValidDatesheetMetadata(meta) {
      return meta is map &&
        meta.keys().hasAll([
          'examName', 'board', 'classGrade', 'academicSession',
          'importantInstructions', 'isUncertain', 'uncertaintyReasons'
        ]) &&
        meta.keys().hasOnly([
          'examName', 'board', 'classGrade', 'academicSession',
          'importantInstructions', 'isUncertain', 'uncertaintyReasons'
        ]) &&
        meta.examName is string && meta.examName.size() <= 160 &&
        meta.board is string && meta.board.size() <= 80 &&
        meta.classGrade is string && meta.classGrade.size() <= 40 &&
        meta.academicSession is string && meta.academicSession.size() <= 40 &&
        meta.importantInstructions is list && meta.importantInstructions.size() <= 25 &&
        meta.isUncertain is bool &&
        meta.uncertaintyReasons is list && meta.uncertaintyReasons.size() <= 10;
    }

    function isValidExamDatesheet(data) {
      return data.keys().hasAll([
          'id', 'userId', 'title', 'status', 'metadata',
          'entries', 'sourceFiles', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'title', 'status', 'metadata',
          'entries', 'sourceFiles', 'confirmedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
        data.status in ['draft', 'confirmed'] &&
        isValidDatesheetMetadata(data.metadata) &&
        data.entries is list && data.entries.size() <= 60 &&
        data.sourceFiles is list && data.sourceFiles.size() <= 10 &&
        (!('confirmedAt' in data) || (data.confirmedAt is string && data.confirmedAt.size() <= 64)) &&
        data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64;
    }

    function isValidExamActivity(data) {
      return data.keys().hasAll(['id', 'userId', 'datesheetId', 'action', 'title', 'detail', 'timestamp']) &&
        data.keys().hasOnly(['id', 'userId', 'datesheetId', 'action', 'title', 'detail', 'timestamp']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.datesheetId is string && data.datesheetId.size() > 0 && data.datesheetId.size() <= 128 &&
        data.action in ['analyzed', 'saved_draft', 'confirmed', 'updated', 'deleted'] &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
        data.detail is string && data.detail.size() <= 320 &&
        data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 64;
    }

    // ==========================================
    // COLLECTION RULES
    // ==========================================

    // 1. User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().role == 'student';
      allow update: if isOwner(userId) && isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().role == existing().role &&
        (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // 2. Atomic Unique Usernames
    match /usernames/{username} {
      allow get: if isSignedIn() && isValidUsernameId(username);
      allow list: if false;
      allow create: if isSignedIn() && isValidUsernameId(username) &&
        isValidUsernameClaim(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().username == username;
      allow update: if false;
      allow delete: if isSignedIn() && isValidUsernameId(username) &&
        existing().uid == request.auth.uid;
    }

    // 3. Module 1: Exam Datesheets (Strict Single-Owner Isolation)
    match /exam_datesheets/{datesheetId} {
      allow get: if isSignedIn() && isValidId(datesheetId) &&
        existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(datesheetId) &&
        isValidExamDatesheet(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().id == datesheetId;
      allow update: if isSignedIn() && isValidId(datesheetId) &&
        existing().userId == request.auth.uid &&
        isValidExamDatesheet(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isValidId(datesheetId) &&
        existing().userId == request.auth.uid;
    }

    // 4. Exam Datesheet Activity Feed
    match /exam_activities/{activityId} {
      allow get: if isSignedIn() && isValidId(activityId) &&
        existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(activityId) &&
        isValidExamActivity(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().id == activityId;
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(activityId) &&
        existing().userId == request.auth.uid;
    }

    // 5. Admins Marker (Read-own only; managed via Admin SDK/Console)
    match /admins/{uid} {
      allow get: if isOwner(uid) && isValidId(uid);
      allow list, create, update, delete: if false;
    }
  }
}
