# GEMINI_API_KEY: Required for server-side Gemini AI features (AI Teacher, Doubt Solver,
# Visual Lab, Adaptive Practice, Flashcards, Exam Simulator, Mind Maps, Voice Classroom, and Study Pods Quiz).
# Provided automatically in Google AI Studio runtime; in Cloud Run, inject via Secret Manager.
GEMINI_API_KEY=""

# EXAM_SESSION_SECRET: Optional (recommended in multi-instance production).
# Used to HMAC-sign Exam Simulator timer and submission integrity tokens across server restarts.
# Generate locally with: openssl rand -hex 32
EXAM_SESSION_SECRET=""

# PORT: Optional HTTP listen port for server.ts (defaults to 3000; Cloud Run injects PORT automatically).
PORT="3000"

# FIREBASE_PROJECT_ID: Optional override for Firebase ID token audience verification.
# Defaults automatically to projectId in firebase-applet-config.json; only set if overriding at runtime.
FIREBASE_PROJECT_ID=""

# VITE_API_BASE_URL: Leave empty for same-origin Cloudflare Pages/Workers deployments.
# Only set if hosting the frontend separately from an external public server.ts backend URL.
VITE_API_BASE_URL=""

# BACKEND_URL: Optional Cloudflare runtime origin to proxy /api/* requests
# to a separately deployed public server.ts Node backend (never set to an ais-dev-* preview URL).
BACKEND_URL=""

# ALLOWED_ORIGINS: Optional comma-separated list of allowed CORS origins for server.ts /api/* routes.
ALLOWED_ORIGINS=""
